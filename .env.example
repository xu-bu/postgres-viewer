# PostgreSQL connection - choose one approach:

# Option 1: Use a complete connection URL (this takes precedence)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/postgres

# Option 2: Use individual standard libpq environment variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# SSL/TLS mode (optional, defaults to 'prefer')
# Options: disable, allow, prefer, require, verify-ca, verify-full
PGSSLMODE=require

# Optional: persistent signing secret for row references (minimum 32 bytes)
# If omitted, a random secret is generated at startup and row references
# expire when the app restarts. Generate one with: openssl rand -base64 32
# POSTGRESUI_ROWKEY_SECRET=replace-with-at-least-32-random-bytes
