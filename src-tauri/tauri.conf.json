{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postgres UI",
  "version": "0.1.0",
  "identifier": "dev.postgresui.desktop",
  "build": {
    "beforeDevCommand": "npm run web:build -- --watch",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Postgres UI",
      "width": 1280,
      "height": 800,
      "maximized": true,
      "minWidth": 760,
      "minHeight": 520,
      "resizable": true
    }],
    "withGlobalTauri": false,
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost", "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Browse and edit PostgreSQL tables"
  }
}
